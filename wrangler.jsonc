{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-09-20",
  // Static-assets-only Worker: no "main", so there is no server bundle and
  // nothing for the OpenNext adapter to do. `out` is Next's static export.
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
